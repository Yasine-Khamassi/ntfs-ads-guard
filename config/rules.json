{
  "allow_stream_names": ["Zone.Identifier", "SmartScreen"],
  "allow_process_paths": [],
  "executable_extensions": [".exe", ".dll", ".scr", ".sys", ".com", ".cpl", ".ps1", ".vbs", ".js", ".hta", ".bat", ".cmd"],
  "system_host_prefixes": ["C:\\Windows\\"],
  "entropy_threshold": 7.0,
  "entropy_min_bytes": 512,
  "stream_size_limit_bytes": 16777216,
  "queue_capacity": 1024,
  "parent_hash_max_bytes": 8388608,
  "thresholds": { "low": 20, "medium": 40, "high": 70 },
  "weights": {
    "named_stream": 10,
    "pe_header": 50,
    "high_entropy": 25,
    "executable_extension": 20,
    "system_binary_host": 15
  }
}
