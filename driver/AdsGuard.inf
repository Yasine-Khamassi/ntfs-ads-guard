[Version]
Signature   = "$WINDOWS NT$"
Class       = "ActivityMonitor"
ClassGuid   = {b86dff51-a31e-4bac-b3cf-e8cfe75c9fc2}
Provider    = %Provider%
DriverVer   = 11/16/2026,2.0.0.0
CatalogFile = AdsGuard.cat
PnpLockdown = 1

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
AdsGuard.sys = 1,,

[DestinationDirs]
AdsGuard.DriverFiles = 12
AdsGuard.DeleteDriverFiles = 12

[DefaultInstall.NTamd64]
OptionDesc = %ServiceDesc%
CopyFiles  = AdsGuard.DriverFiles

[DefaultInstall.NTamd64.Services]
AddService = AdsGuard,,AdsGuard.Service

[DefaultUninstall.NTamd64]
LegacyUninstall = 1
DelFiles        = AdsGuard.DeleteDriverFiles

[DefaultUninstall.NTamd64.Services]
DelService = AdsGuard,0x200

[AdsGuard.Service]
DisplayName    = %ServiceDesc%
Description    = %ServiceDesc%
ServiceBinary  = %12%\AdsGuard.sys
Dependencies   = "FltMgr"
ServiceType    = 2
StartType      = 3
ErrorControl   = 1
LoadOrderGroup = "FSFilter Activity Monitor"
AddReg         = AdsGuard.Instances

; DEVELOPMENT-ONLY ALTITUDE. FSFilter Activity Monitor is 360000 to 389999.
; 389992 is not in Microsoft's allocated altitude list (October 2026 update),
; which has no Activity Monitor entries above 389560.5. It is not assigned to
; this project and may be given to someone else at any time. Use it in test
; VMs only. See docs/ALTITUDE.md before shipping anything.
[AdsGuard.Instances]
HKR,"Parameters\Instances","DefaultInstance",0x00000000,%InstanceName%
HKR,"Parameters\Instances\"%InstanceName%,"Altitude",0x00000000,%Altitude%
HKR,"Parameters\Instances\"%InstanceName%,"Flags",0x00010001,0

[AdsGuard.DriverFiles]
AdsGuard.sys

[AdsGuard.DeleteDriverFiles]
AdsGuard.sys

[Strings]
Provider     = "NTFS ADS Guard"
DiskName     = "NTFS ADS Guard Installation Disk"
ServiceDesc  = "NTFS ADS Guard Minifilter"
InstanceName = "AdsGuard Instance"
Altitude     = "389992" ; development only, see docs/ALTITUDE.md
